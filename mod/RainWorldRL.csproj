<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Rain World installation directory. Override on the command line:
      dotnet build -p:RainWorldDir="D:/Games/Rain World"
    rainworld_rl/launcher.py reads it from rainworld_rl.toml and passes it here.
  -->
  <PropertyGroup>
    <RainWorldDir Condition="'$(RainWorldDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Rain World</RainWorldDir>
    <RainWorldManaged>$(RainWorldDir)/RainWorld_Data/Managed</RainWorldManaged>
    <BepInExCore>$(RainWorldDir)/BepInEx/core</BepInExCore>
    <BepInExPlugins>$(RainWorldDir)/BepInEx/plugins</BepInExPlugins>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(RainWorldManaged)/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RainWorldManaged)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RainWorldManaged)/UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(RainWorldManaged)/UnityEngine.ScreenCaptureModule.dll</HintPath>
    </Reference>

    <!-- Rain World game code -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RainWorldManaged)/Assembly-CSharp.dll</HintPath>
    </Reference>

    <!-- MonoMod hooks (On.* classes) -->
    <Reference Include="HOOKS-Assembly-CSharp">
      <HintPath>$(BepInExPlugins)/HOOKS-Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(BepInExCore)/MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(BepInExCore)/Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(BepInExCore)/MonoMod.Utils.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
